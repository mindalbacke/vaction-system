{
  "manifest_version": 3,
  "name": "반차관리 휴가 도우미",
  "version": "0.3.3",
  "description": "반차 두 건을 휴가 1일로 계산하고 MBC 인사정보 휴가 신청 화면 입력을 돕습니다.",
  "permissions": ["storage", "tabs", "webNavigation", "scripting"],
  "host_permissions": [
    "https://insa.mbc.co.kr/*",
    "https://*.mbc.co.kr/*",
    "https://teum-half-day.halfday-ops.workers.dev/*",
    "http://localhost:*/*"
  ],
  "action": {
    "default_title": "반차관리 휴가 도우미",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "mole-icon.png",
      "32": "mole-icon.png",
      "48": "mole-icon.png",
      "128": "mole-icon.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "mole-icon.png",
    "32": "mole-icon.png",
    "48": "mole-icon.png",
    "128": "mole-icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://insa.mbc.co.kr/*", "https://*.mbc.co.kr/*"],
      "js": ["content-script.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://teum-half-day.halfday-ops.workers.dev/*",
        "http://localhost:*/*"
      ],
      "js": ["site-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
